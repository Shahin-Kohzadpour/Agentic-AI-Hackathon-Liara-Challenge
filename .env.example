# Keep credentials here locally. Never commit .env or paste its contents in chat.
LIARA_API_TOKEN=
# Set this to an existing disposable Liara Node.js project for live operations.
LIARA_PROJECT=
# CLI uses its documented raw Authorization token. Adjust only after a read-only spike.
LIARA_AUTH_SCHEME=bearer
LIARA_TEAM_ID=
# Optional custom domain for this one administrator-configured sample project.
LIARA_APP_URL=
# Default: local control plane. No paid cloud resources are created automatically.
PORT=4317
# Optional model override; an empty value uses the locally configured Codex default.
CODEX_MODEL=
